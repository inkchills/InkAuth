{
  app: {
    signingConfigs: [],
    products: [
      {
        name: "default",
        targetSdkVersion: "6.0.2(22)",
        compatibleSdkVersion: "6.0.0(20)",
        runtimeOS: "HarmonyOS",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: "debug"
      },
      {
        name: "release"
      },
    ],
  },
  modules: [
    {
      name: "InkAuthApp",
      srcPath: "./products/InkAuthApp",
      targets: [
        {
          name: "default",
          applyToProducts: [
            "default"
          ]
        }
      ],
    },
    {
      name: "common",
      srcPath: "./common",
      targets: [
        {
          name: "default"
        }
      ],
    },
    {
      name: "adaptiveLayout",
      srcPath: "./features/adaptiveLayout",
      targets: [
        {
          name: "default"
        }
      ],
    },
    {
      name: "responsiveLayout",
      srcPath: "./features/responsiveLayout",
      targets: [
        {
          name: "default"
        }
      ],
    },
  ],
}