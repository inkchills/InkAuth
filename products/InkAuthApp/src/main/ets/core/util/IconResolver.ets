/**
 * 图标解析器，用于根据服务名称解析对应的图标资源
 */
export class IconResolver {
  private static iconPackIcons: Map<string, ResourceStr> = new Map();
  private static customIcons: Map<string, ResourceStr> = new Map();

  public static registerIconPackIcon(key: string, source: ResourceStr): void {
    IconResolver.iconPackIcons.set(key, source);
  }

  public static clearIconPackIcons(): void {
    IconResolver.iconPackIcons.clear();
  }

  public static registerCustomIcon(key: string, source: ResourceStr): void {
    IconResolver.customIcons.set(key, source);
  }

  public static unregisterCustomIcon(key: string): void {
    IconResolver.customIcons.delete(key);
  }

  public static clearCustomIcons(): void {
    IconResolver.customIcons.clear();
  }

  /**
   * 查找服务图标键
   */
  public static findServiceKeyByName(name: string): string | null {
    if (!name) return null;
    const simplify = (input: string): string => {
      return input.toLowerCase().replace(/[^a-z0-9]/g, '').trim();
    };

    const key = simplify(name);
    // 检查是否有直接匹配
    if (IconMap.has(key)) {
      return key;
    }

    // 检查首词匹配 (First word logic)
    const firstWordKey = simplify(name.split(/[ .]/, 2)[0]);
    if (IconMap.has(firstWordKey)) {
      return firstWordKey; 
    }

    return null;
  }

  /**
   * 获取服务图标资源
   */
  public static getService(key: string | null): ResourceStr {
    if (key && key.startsWith('data:image/')) {
      return key;
    }
    if (key && IconResolver.customIcons.has(key)) {
      return IconResolver.customIcons.get(key)!;
    }
    if (key && IconResolver.iconPackIcons.has(key)) {
      return IconResolver.iconPackIcons.get(key)!;
    }
    if (key && IconMap.has(key)) {
      return IconMap.get(key)!;
    }
    return DefaultIcon;
  }
}

