function buildIconMap(): Map<string, Resource> {
  const icons: Map<string, Resource> = new Map();

  AuthenticatorIconMediaNames.forEach((mediaName: string, key: string) => {
    icons.set(key, $r(`app.media.${mediaName}`));
  });

  AndroidServiceIconKeys.forEach((key: string) => {
    icons.set(key, $r(`app.media.${key}`));
  });

  icons.set("default", DefaultIcon);
  return icons;
}

export const IconMap: Map<string, Resource> = buildIconMap();
