{
    module: {
        name: "InkAuthApp",
        type: "entry",
        description: "$string:module_desc",
        mainElement: "InkAuthAbility",
        deviceTypes: ["phone"],
        deliveryWithInstall: true,
        installationFree: false,
        pages: "$profile:main_pages",
        requestPermissions: [
            {
                name: "ohos.permission.CAMERA",
                reason: "$string:camera_permission_reason",
                usedScene: {
                    abilities: ["InkAuthAbility"],
                    when: "inuse",
                },
            },
            {
                name: "ohos.permission.PRIVACY_WINDOW",
                reason: "$string:privacy_window_permission_reason",
                usedScene: {
                    abilities: ["InkAuthAbility"],
                    when: "always",
                },
            },
            {
                name: "ohos.permission.ACCESS_BIOMETRIC",
                reason: "$string:access_biometric_permission_reason",
                usedScene: {
                    abilities: ["InkAuthAbility"],
                    when: "inuse",
                },
            },
        ],
        abilities: [
            {
                name: "InkAuthAbility",
                srcEntry: "./ets/inkauthability/InkAuthAbility.ets",
                description: "$string:ability_desc",
                icon: "$media:layered_image",
                label: "$string:ability_label",
                startWindowIcon: "$media:startIcon",
                startWindowBackground: "$color:start_window_background",
                exported: true,
                skills: [
                    {
                        entities: ["entity.system.home"],
                        actions: ["ohos.want.action.home"],
                    },
                    {
                        actions: ["ohos.want.action.viewData"],
                        uris: [
                            {
                                scheme: "otpauth",
                            },
                            {
                                scheme: "otpauth-migration",
                            },
                            {
                                scheme: "motp",
                            },
                        ],
                    },
                ],
            },
        ],
        extensionAbilities: [
            {
                name: "InkAuthBackupAbility",
                srcEntry: "./ets/inkauthbackupability/InkAuthBackupAbility.ets",
                type: "backup",
                exported: false,
                metadata: [
                    {
                        name: "ohos.extension.backup",
                        resource: "$profile:backup_config",
                    },
                ],
            },
        ],
    },
}
